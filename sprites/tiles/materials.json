  "about": "Level materials shared by the editor and the badge. tools/draw_tiles.py draws the atlas and tools/build_assets.py packs it into Lua.",
  "properties": {
    "walk": "Blocks movement for the player and enemies. Enemies path around it.",
    "shots": "Stops direct fire: bullets, pellets, rockets, bank rounds, charge bolts, flame and frost streams, rail and arc beams, enemy beams and melee strikes.",
    "lobs": "Stops thrown and lobbed weapons (grenades, lobber shells, discs, orbs). Low cover leaves this off so grenades arc over it.",
    "sight": "Blocks enemy line of sight. Idle enemies cannot notice the player through it.",
    "pierce": "The rail rifle passes through it even though it stops other shots.",
    "hp": "Destructible. Gunfire and blasts that hit the tile drain this many points.",
    "breaksTo": "Material left behind when the tile is destroyed. Omit to leave the cell empty.",
    "explodes": "Blast when destroyed: damage at the centre and radius in native pixels. Hurts the player and enemies alike and chains into nearby tiles.",
    "slow": "Movement speed multiplier while standing on the tile (1 = normal).",
    "hazard": "Damage per second to the player while standing on the tile.",
    "overhead": "Roof. Drawn above actors and hidden while the player stands under the same connected roof.",
    "autotile": "area joins edges and diagonal cutouts; blob joins straight runs, corners, ends and junctions; orient follows adjacent walls; lane follows adjacent markings.",
    "group": "Materials with the same group share connected edges.",
    "span": "Half-width in native pixels of connected structure arms and their collision.",
    "bounds": "Collision rectangle in tile pixels [left, top, right, bottom], excluding cast shadows.",
    "height": "Top of the obstacle above ground in native pixels. Roof decks are at 24 px.",
    "variants": "Number of texture variations picked deterministically by cell.",
    "underlay": "Default surface beneath the transparent edges of this ground material.",
    "detail": "Paints over an existing roof while keeping its material and shape."
  },
  "layers": {
    "ground": "Floor of every cell. Always present.",
    "structure": "Walls, cover and props on top of the ground. At most one per cell.",
    "roof": "Overhead layer above structures and actors."
